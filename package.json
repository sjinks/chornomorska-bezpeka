{
  "name": "chornomorska-library",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "data": "python3 link_authors.py && tsx scripts/prepare-data.ts",
    "build": "npm run typecheck && npm run data && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test test/*.test.ts && python3 -m unittest discover -s test -p \"test_*.py\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "bootstrap": "^5.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@myrotvorets/eslint-config-myrotvorets-ts": "^4.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
